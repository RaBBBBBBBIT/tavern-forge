{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tavern-forge.dev/schemas/state/state-mutation.schema.json",
  "title": "StateMutation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "https://tavern-forge.dev/schemas/common/schema-version.schema.json" },
    "id": { "$ref": "https://tavern-forge.dev/schemas/common/id.schema.json" },
    "namespace": { "type": "string", "pattern": "^(core|plugin:[a-zA-Z0-9._-]+)$" },
    "operation": { "type": "string", "enum": ["set", "replace", "add", "remove"] },
    "path": { "type": "string", "pattern": "^/[A-Za-z0-9_./~-]+$" },
    "value": {},
    "sourceEventIds": {
      "type": "array",
      "items": { "$ref": "https://tavern-forge.dev/schemas/common/id.schema.json" },
      "minItems": 1,
      "uniqueItems": true
    },
    "expectedStateVersion": { "type": "integer", "minimum": 0 }
  },
  "required": ["schemaVersion", "id", "namespace", "operation", "path", "sourceEventIds", "expectedStateVersion"],
  "allOf": [
    {
      "if": { "properties": { "operation": { "enum": ["set", "replace", "add"] } } },
      "then": { "required": ["value"] }
    }
  ]
}
