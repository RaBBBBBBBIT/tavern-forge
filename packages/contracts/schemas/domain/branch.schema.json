{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tavern-forge.dev/schemas/domain/branch.schema.json",
  "title": "Branch",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "https://tavern-forge.dev/schemas/common/schema-version.schema.json" },
    "id": { "$ref": "https://tavern-forge.dev/schemas/common/id.schema.json" },
    "storyId": { "$ref": "https://tavern-forge.dev/schemas/common/id.schema.json" },
    "parentBranchId": { "type": ["string", "null"] },
    "forkCheckpointId": { "type": ["string", "null"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "type": "string", "enum": ["active", "archived"] },
    "headSequence": { "type": "integer", "minimum": 0 },
    "activeSceneId": { "type": ["string", "null"] },
    "stateVersion": { "type": "integer", "minimum": 0 },
    "createdAt": { "$ref": "https://tavern-forge.dev/schemas/common/timestamp.schema.json" },
    "updatedAt": { "$ref": "https://tavern-forge.dev/schemas/common/timestamp.schema.json" }
  },
  "required": ["schemaVersion", "id", "storyId", "name", "status", "headSequence", "stateVersion", "createdAt", "updatedAt"]
}
